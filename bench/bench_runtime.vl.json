{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Runtime (100 MB input)",
  "data": {
    "url": "hq-bench.csv"
  },
  "vconcat": [
    {
      "width": 400,
      "height": {
        "step": 24
      },
      "transform": [
        {
          "calculate": "slice(datum.command, 0, 2) == 'hq' ? 'hq' : 'jq'",
          "as": "backend"
        },
        {
          "aggregate": [
            {
              "op": "median",
              "field": "runtime",
              "as": "runtime_median"
            }
          ],
          "groupby": [
            "command",
            "backend"
          ]
        }
      ],
      "mark": "bar",
      "encoding": {
        "y": {
          "field": "command",
          "type": "nominal",
          "title": null,
          "sort": null,
          "axis": {
            "labelLimit": 0
          }
        },
        "x": {
          "field": "runtime_median",
          "type": "quantitative",
          "title": "Runtime median (s)"
        },
        "color": {
          "field": "backend",
          "type": "nominal",
          "title": "backend",
          "scale": {
            "domain": [
              "hq",
              "jq"
            ],
            "range": [
              "#DD2233",
              "#333333"
            ]
          }
        },
        "tooltip": [
          {
            "field": "command",
            "type": "nominal"
          },
          {
            "field": "runtime_median",
            "type": "quantitative",
            "title": "Runtime median (s)"
          }
        ]
      }
    },
    {
      "title": "Average (mean of medians)",
      "width": 400,
      "height": {
        "step": 24
      },
      "transform": [
        {
          "calculate": "slice(datum.command, 0, 2) == 'hq' ? 'hq' : 'jq'",
          "as": "backend"
        },
        {
          "aggregate": [
            {
              "op": "median",
              "field": "runtime",
              "as": "runtime_median"
            }
          ],
          "groupby": [
            "command",
            "backend"
          ]
        },
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "runtime_median",
              "as": "runtime_average"
            }
          ],
          "groupby": [
            "backend"
          ]
        },
        {
          "calculate": "datum.backend",
          "as": "command"
        }
      ],
      "mark": "bar",
      "encoding": {
        "y": {
          "field": "command",
          "type": "nominal",
          "title": null,
          "sort": [
            "hq",
            "jq"
          ],
          "axis": {
            "labelLimit": 0
          }
        },
        "x": {
          "field": "runtime_average",
          "type": "quantitative",
          "title": "Runtime average (s)"
        },
        "color": {
          "field": "backend",
          "type": "nominal",
          "title": "backend",
          "scale": {
            "domain": [
              "hq",
              "jq"
            ],
            "range": [
              "#DD2233",
              "#333333"
            ]
          }
        },
        "tooltip": [
          {
            "field": "command",
            "type": "nominal"
          },
          {
            "field": "runtime_average",
            "type": "quantitative",
            "title": "Runtime average (s)"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "x": "shared",
      "color": "shared"
    }
  },
  "config": {
    "view": {
      "continuousWidth": 400,
      "continuousHeight": 300
    },
    "axis": {
      "labelFont": "monospace",
      "titleFont": "monospace"
    },
    "legend": {
      "labelFont": "monospace",
      "titleFont": "monospace"
    },
    "title": {
      "font": "monospace",
      "anchor": "middle"
    }
  }
}