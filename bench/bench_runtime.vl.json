{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Runtime (100 MB input)",
  "width": 756,
  "height": {
    "step": 40
  },
  "data": {
    "url": "hq-bench.csv"
  },
  "transform": [
    {
      "calculate": "slice(datum.command, 0, 2) == 'hq' ? 'hq' : 'jq'",
      "as": "backend"
    },
    {
      "aggregate": [{ "op": "median", "field": "runtime", "as": "runtime_median" }],
      "groupby": ["command", "backend"]
    }
  ],
  "mark": "bar",
  "encoding": {
    "y": {
      "field": "command",
      "type": "nominal",
      "title": null,
      "sort": null
    },
    "x": {
      "field": "runtime_median",
      "type": "quantitative",
      "title": "Runtime median (s)"
    },
    "color": {
      "field": "backend",
      "type": "nominal",
      "title": "backend",
      "scale": {
        "domain": [
          "hq",
          "jq"
        ],
        "range": [
          "#DD2233",
          "#333333"
        ]
      }
    },
    "tooltip": [
      {
        "field": "command",
        "type": "nominal"
      },
      {
        "field": "runtime_median",
        "type": "quantitative",
        "title": "Runtime median (s)"
      }
    ]
  },
  "config": {
    "axis": {
      "labelFont": "monospace",
      "titleFont": "monospace"
    },
    "legend": {
      "labelFont": "monospace",
      "titleFont": "monospace"
    },
    "title": {
      "font": "monospace"
    }
  }
}