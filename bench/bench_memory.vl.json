{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Peak RSS (100 MB input)",
  "data": {
    "url": "hq-bench.csv"
  },
  "vconcat": [
    {
      "width": 400,
      "height": {
        "step": 24
      },
      "transform": [
        {
          "calculate": "slice(datum.command, 0, 2) == 'hq' ? 'hq' : 'jq'",
          "as": "backend"
        },
        {
          "aggregate": [
            {
              "op": "median",
              "field": "peak_rss_mb",
              "as": "peak_rss_mb_median"
            }
          ],
          "groupby": [
            "command",
            "backend"
          ]
        }
      ],
      "mark": "bar",
      "encoding": {
        "y": {
          "field": "command",
          "type": "nominal",
          "title": null,
          "sort": null,
          "axis": {
            "labelLimit": 0
          }
        },
        "x": {
          "field": "peak_rss_mb_median",
          "type": "quantitative",
          "title": "Peak RSS (MB)"
        },
        "color": {
          "field": "backend",
          "type": "nominal",
          "title": "backend",
          "scale": {
            "domain": [
              "hq",
              "jq"
            ],
            "range": [
              "#DA3322",
              "#333333"
            ]
          }
        },
        "tooltip": [
          {
            "field": "command",
            "type": "nominal"
          },
          {
            "field": "peak_rss_mb_median",
            "type": "quantitative",
            "title": "Peak RSS (MB)"
          }
        ]
      }
    },
    {
      "title": "Average",
      "width": 800,
      "height": {
        "step": 24
      },
      "transform": [
        {
          "calculate": "slice(datum.command, 0, 2) == 'hq' ? 'hq' : 'jq'",
          "as": "backend"
        },
        {
          "aggregate": [
            {
              "op": "median",
              "field": "peak_rss_mb",
              "as": "peak_rss_mb_median"
            }
          ],
          "groupby": [
            "command",
            "backend"
          ]
        },
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "peak_rss_mb_median",
              "as": "peak_rss_mb_average"
            }
          ],
          "groupby": [
            "backend"
          ]
        },
        {
          "calculate": "datum.backend",
          "as": "command"
        }
      ],
      "mark": "bar",
      "encoding": {
        "y": {
          "field": "command",
          "type": "nominal",
          "title": null,
          "sort": [
            "hq",
            "jq"
          ],
          "axis": {
            "labelLimit": 0
          }
        },
        "x": {
          "field": "peak_rss_mb_average",
          "type": "quantitative",
          "title": "Peak RSS (MB)"
        },
        "color": {
          "field": "backend",
          "type": "nominal",
          "title": "backend",
          "scale": {
            "domain": [
              "hq",
              "jq"
            ],
            "range": [
              "#DA3322",
              "#333333"
            ]
          }
        },
        "tooltip": [
          {
            "field": "command",
            "type": "nominal"
          },
          {
            "field": "peak_rss_mb_average",
            "type": "quantitative",
            "title": "Peak RSS (MB)"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "x": "shared",
      "color": "shared"
    }
  },
  "config": {
    "axis": {
      "labelFont": "monospace",
      "titleFont": "monospace"
    },
    "legend": {
      "labelFont": "monospace",
      "titleFont": "monospace"
    },
    "title": {
      "font": "monospace",
      "anchor": "middle"
    }
  }
}
